# Dependency cooldown: refuse any package version published within the last 7
# days. A compromised npm release is usually detected and yanked within hours,
# so a rolling window filters it out before it reaches node_modules or a
# lockfile. The gate applies when npm resolves (`npm install`, `npm update`);
# `npm ci` replays the committed lockfile.
#
# Requires npm >= 11.10.0. An older npm ignores this key.
#
# npm reads only the .npmrc of the folder it runs in, so each TypeScript
# example carries a short copy of this line.
min-release-age=7
