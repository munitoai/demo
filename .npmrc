# Dependency cooldown: refuse to install any package version published within
# the last 7 days. Compromised npm releases are typically detected and yanked
# within hours, so a rolling window filters them out before they reach
# node_modules / the lockfile. The gate applies when resolving (`npm install`,
# `npm update`); `npm ci` just replays the committed lock.
#
# Requires npm >= 11.10.0 (older npm silently ignores this key). One file for
# the whole workspace: the admin SPA used to carry its own copy because it lived
# outside this tree, and "keep them in sync" is not a mechanism.
min-release-age=7
