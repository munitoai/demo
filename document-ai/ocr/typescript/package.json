    "check": "npm run format:check && npm run build",
    "data:fetch": "node ../data/fetch.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.45",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
